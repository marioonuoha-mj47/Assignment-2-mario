<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- "title" comes from the route's res.render call -->
  <title><%= title %> | Mario Onuoha</title>
  <!-- Bootstrap CSS (mandatory): grid, navbar, cards, buttons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome (mandatory): icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <!-- Our own CSS from the public folder ("public" is not part of the URL) -->
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <!-- Navbar shown on every page; links match the routes in routes/index.js -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Mario Onuoha</a>
      <!-- Hamburger button for small screens -->
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav ms-auto">
          <!-- The "active" class highlights the link for the current page -->
          <li class="nav-item"><a class="nav-link <%= title === 'Home' ? 'active' : '' %>" href="/"><i class="fa-solid fa-house"></i> Home</a></li>
          <li class="nav-item"><a class="nav-link <%= title === 'About Me' ? 'active' : '' %>" href="/about"><i class="fa-solid fa-user"></i> About</a></li>
          <li class="nav-item"><a class="nav-link <%= title === 'Projects' ? 'active' : '' %>" href="/projects"><i class="fa-solid fa-code"></i> Projects</a></li>
          <li class="nav-item"><a class="nav-link <%= title === 'Contact Me' ? 'active' : '' %>" href="/contact"><i class="fa-solid fa-envelope"></i> Contact</a></li>
        </ul>
      </div>
    </div>
  </nav>
  <!-- Main content area: each page's content goes between header and footer -->
  <main class="container flex-grow-1 py-5">